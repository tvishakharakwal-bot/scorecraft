import { useState, useMemo, useEffect } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { motion } from "framer-motion";
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  Tooltip,
  ResponsiveContainer
} from "recharts";

const gradePoints = {
  "A": 4,
  "A-": 3.7,
  "B+": 3.3,
  "B": 3.0,
  "B-": 2.7,
  "C+": 2.3,
  "C": 2.0,
  "C-": 1.7,
  "D": 1.0,
  "F": 0
};

export default function ScoreCraft() {
  const [courses, setCourses] = useState([]);
  const [name, setName] = useState("");
  const [grade, setGrade] = useState("A");
  const [credits, setCredits] = useState(1);

  const [user, setUser] = useState(() => localStorage.getItem("sc_user") || "");
  const [tempUser, setTempUser] = useState("");

  const [gpaHistory, setGpaHistory] = useState([]);

  // Load saved data
  useEffect(() => {
    if (!user) return;
    const saved = localStorage.getItem(`sc_data_${user}`);
    if (saved) {
      const parsed = JSON.parse(saved);
      setCourses(parsed.courses || []);
      setGpaHistory(parsed.gpaHistory || []);
    }
  }, [user]);

  // Save data
  useEffect(() => {
    if (!user) return;
    localStorage.setItem(
      `sc_data_${user}`,
      JSON.stringify({ courses, gpaHistory })
    );
  }, [courses, gpaHistory, user]);

  const gpa = useMemo(() => {
    if (courses.length === 0) return 0;

    let totalPoints = 0;
    let totalCredits = 0;

    courses.forEach(c => {
      totalPoints += (gradePoints[c.grade] || 0) * c.credits;
      totalCredits += c.credits;
    });

    return totalCredits ? (totalPoints / totalCredits).toFixed(2) : 0;
  }, [courses]);

  const addCourse = () => {
    if (!name) return;
    setCourses([...courses, { name, grade, credits: Number(credits) }]);
    setName("");
  };

  const saveSnapshot = () => {
    setGpaHistory([
      ...gpaHistory,
      { time: gpaHistory.length + 1, gpa: Number(gpa) }
    ]);
  };

  const login = () => {
    localStorage.setItem("sc_user", tempUser);
    setUser(tempUser);
  };

  return (
    <div className="min-h-screen bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white p-4 md:p-8">

      {/* Header */}
      <div className="flex flex-col md:flex-row justify-between items-center gap-3 mb-6">
        <h1 className="text-2xl font-bold">ScoreCraft</h1>

        {!user ? (
          <div className="flex gap-2 w-full md:w-auto">
            <Input placeholder="Username" value={tempUser} onChange={e => setTempUser(e.target.value)} />
            <Button onClick={login}>Login</Button>
          </div>
        ) : (
          <p className="opacity-70">Welcome, {user}</p>
        )}
      </div>

      {/* Hero */}
      <motion.div className="text-center mb-8">
        <h2 className="text-4xl font-bold">Build. Track. Improve.</h2>
        <p className="opacity-70">A structured GPA system inspired by growth and precision.</p>
      </motion.div>

      {/* GPA + Saturn Visual */}
      <Card className="mb-6">
        <CardContent className="p-6 text-center">
          <h2 className="text-xl font-semibold mb-4">Current GPA</h2>

          {/* Saturn Ring Visual */}
          <div className="relative flex items-center justify-center mb-4">
            <div className="w-28 h-28 rounded-full bg-white/10 flex items-center justify-center text-2xl font-bold">
              {gpa}
            </div>
            <div className="absolute w-40 h-40 border-2 border-blue-400/40 rounded-full animate-spin-slow" />
          </div>

          <Button onClick={saveSnapshot}>Save GPA Snapshot</Button>
        </CardContent>
      </Card>

      {/* GPA Calculator */}
      <Card className="mb-6">
        <CardContent className="p-6">
          <h2 className="text-xl font-semibold mb-4">Add Course</h2>

          <div className="grid md:grid-cols-4 gap-2">
            <Input placeholder="Course" value={name} onChange={e => setName(e.target.value)} />

            <select className="text-black p-2 rounded" value={grade} onChange={e => setGrade(e.target.value)}>
              {Object.keys(gradePoints).map(g => (
                <option key={g}>{g}</option>
              ))}
            </select>

            <Input type="number" value={credits} onChange={e => setCredits(e.target.value)} />

            <Button onClick={addCourse}>Add</Button>
          </div>
        </CardContent>
      </Card>

      {/* Courses */}
      <Card className="mb-6">
        <CardContent className="p-6">
          <h2 className="text-xl font-semibold mb-4">Courses</h2>
          {courses.length === 0 && <p className="opacity-60">No courses yet.</p>}

          {courses.map((c, i) => (
            <div key={i} className="flex justify-between border-b border-gray-700 py-2">
              <span>{c.name}</span>
              <span>{c.grade} • {c.credits} credits</span>
            </div>
          ))}
        </CardContent>
      </Card>

      {/* GPA Chart */}
      <Card className="mb-6">
        <CardContent className="p-6">
          <h2 className="text-xl font-semibold mb-4">Progress Chart</h2>

          {gpaHistory.length === 0 ? (
            <p className="opacity-60">No GPA history yet.</p>
          ) : (
            <div className="w-full h-64">
              <ResponsiveContainer>
                <LineChart data={gpaHistory}>
                  <XAxis dataKey="time" />
                  <YAxis domain={[0, 4]} />
                  <Tooltip />
                  <Line type="monotone" dataKey="gpa" stroke="#60a5fa" />
                </LineChart>
              </ResponsiveContainer>
            </div>
          )}
        </CardContent>
      </Card>

      {/* Footer */}
      <p className="text-center text-sm opacity-50">© ScoreCraft</p>

      {/* Simple animation style */}
      <style>{`
        .animate-spin-slow {
          animation: spin 12s linear infinite;
        }
        @keyframes spin {
          from { transform: rotate(0deg); }
          to { transform: rotate(360deg); }
        }
      `}</style>
    </div>
  );
}
